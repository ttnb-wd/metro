import {test} from 'node:test';import assert from 'node:assert/strict';import {readFileSync,mkdtempSync,rmSync,writeFileSync} from 'node:fs';import {tmpdir} from 'node:os';import {resolve,join} from 'node:path';import {spawnSync} from 'node:child_process';
const code=readFileSync('scripts/workers/release-controller.py','utf8').match(/rollback='''([\s\S]*?)'''/)?.[1];assert(code);
for(const mode of ['candidate','foreign','committed'])test(`worker rollback ${mode} is fail closed and cannot start Telegram or legacy commerce`,()=>{const root=mkdtempSync(join(tmpdir(),'metro-worker-rollback-'));try{if(mode==='committed')writeFileSync(join(root,'committed'),'fixture');const label=mode==='foreign'?'wrong':root.split(/[\\/]/).at(-1);const script=`import subprocess,json,sys\nfrom types import SimpleNamespace\ncalls=[]\ndef fake(a,**kw):\n calls.append(a)\n if a[:2]==['docker','inspect']:\n  return SimpleNamespace(returncode=0,stdout=json.dumps([{'Config':{'Labels':{'metro.worker.release':${JSON.stringify(label)}}}}]))\n return SimpleNamespace(returncode=0,stdout='')\nsubprocess.run=fake\nsys.argv=['rollback',${JSON.stringify(root)},'legacy-fixture','canary-fixture']\ntry:exec(${JSON.stringify(code)})\nexcept SystemExit:pass\nprint(json.dumps(calls))`;
const r=spawnSync('python',['-c',script],{encoding:'utf8',windowsHide:true,timeout:10000});assert.equal(r.status,0,r.stderr);const calls:string[][]=JSON.parse(r.stdout);assert.equal(calls.some(c=>c.includes('start')),false);assert.equal(calls.some(c=>c.some(s=>/metro-vpn-bot|metro-website-api|metro-notification-worker/.test(s))),false);if(mode==='candidate'){assert(calls.some(c=>c.join(' ')==='docker stop --time 20 metro-commerce-worker'));assert(calls.some(c=>c.join(' ')==='docker rename legacy-fixture metro-commerce-worker'));}if(mode==='foreign')assert.equal(calls.some(c=>c.includes('rm')),false);if(mode==='committed')assert.equal(calls.length,0)}finally{const target=resolve(root);assert(target.startsWith(resolve(tmpdir())+'\\')||target.startsWith(resolve(tmpdir())+'/'));rmSync(target,{recursive:true,force:true})}});
