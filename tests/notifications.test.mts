import { test } from "node:test";
import assert from "node:assert/strict";
import { randomUUID } from "node:crypto";
import { serviceStatus, formatRemaining, DATA_GB } from "../src/features/workspace/service-status.ts";
import { statusNotice } from "../src/server/notifications/policy.ts";
import { notificationEmail, deliveryFailure } from "../src/server/notifications/email.ts";
import { liveServiceStatus } from "../src/server/vpn/live-status.ts";
import type { Entitlement } from "../src/server/vpn/contracts.ts";
const now = Date.now(), userId = randomUUID(), id = randomUUID(), serviceId = randomUUID();
const snapshot = (remaining: bigint = DATA_GB): Entitlement => ({ id, owner: { issuer: "metro-website", subject: userId }, packageId: randomUUID(), version: 1, status: "ACTIVE", keyId: "mw-" + "a".repeat(48), keyStatus: "ENFORCED", expiresAt: new Date(now + 86400000).toISOString(), totalBytes: (DATA_GB * BigInt(2)).toString(), usedBytes: (DATA_GB * BigInt(2) - remaining).toString(), remainingBytes: remaining.toString(), usageHistoryVersion: 1, observedAt: new Date(now).toISOString() });
for (const [bytes, expected] of [[DATA_GB + BigInt(1), "ACTIVE"], [DATA_GB, "ACTIVE"], [DATA_GB - BigInt(1), "LOW_DATA"], [BigInt(0), "DATA_EXHAUSTED"]] as const) test(`remaining ${bytes} bytes resolves to ${expected}`, () => { const data = snapshot(bytes); assert.equal(serviceStatus(data, now).condition, expected); assert.equal(!!statusNotice(userId, serviceId, data, now), expected !== "ACTIVE"); });
test("expiry and quota are independent; both reasons survive together", () => { const data = snapshot(BigInt(0)); data.expiresAt = new Date(now - 1).toISOString(); data.status = "EXPIRED"; const result = serviceStatus(data, now); assert.equal(result.condition, "BOTH_EXHAUSTED"); assert.equal(result.reasons.length, 2); assert.ok(result.renew && result.topUp && !result.canConnect); assert.equal(statusNotice(userId, serviceId, data, now)?.kind, "BOTH_EXHAUSTED"); const expired = { ...snapshot(), expiresAt: data.expiresAt }; assert.equal(serviceStatus(expired, now).condition, "EXPIRED"); });
test("unavailable, stale, missing and future observations never turn into zero usage or connect permission", () => { for (const data of [null, { ...snapshot(), observedAt: null }, { ...snapshot(), observedAt: new Date(now - 120001).toISOString() }, { ...snapshot(), observedAt: new Date(now + 6000).toISOString() }]) { const state = serviceStatus(data, now); assert.equal(state.usedBytes, null); assert.equal(state.remainingBytes, null); assert.equal(state.canConnect, false); } assert.equal(serviceStatus(snapshot(), now, false).condition, "UNAVAILABLE"); });
test("low-data warnings use actual units and remain one business event per version", () => { const one = snapshot(BigInt(1)); assert.match(formatRemaining(one.remainingBytes), /1 bytes/); const a = statusNotice(userId, serviceId, one, now)!; const b = statusNotice(userId, serviceId, { ...one, remainingBytes: "0", usedBytes: one.totalBytes }, now)!; assert.equal(a.dedupeKey, statusNotice(userId, serviceId, one, now)!.dedupeKey); assert.notEqual(a.dedupeKey, b.dedupeKey); assert.notEqual(a.dedupeKey, statusNotice(userId, serviceId, { ...one, version: 2 }, now)!.dedupeKey); });
test("live status rejects foreign owners, old versions, unavailable counters and malformed usage", async () => { const reference = { userId, externalId: id, version: 1 }; for (const value of [{ ...snapshot(), owner: { issuer: "metro-website", subject: randomUUID() } }, { ...snapshot(), version: 0 }, { ...snapshot(), usedBytes: null }]) { const result = await liveServiceStatus(reference, async () => value, now); assert.equal(result.entitlement, null); assert.equal(result.status.canConnect, false); } const result = await liveServiceStatus(reference, async () => { throw Error("private internal diagnostic"); }, now); assert.equal(result.status.remainingBytes, null); });
test("email includes safe plain text and escaped branded HTML without key credentials", () => { const draft = statusNotice(userId, serviceId, snapshot(BigInt(5)), now)!; draft.payload.title = "Metro <update>"; const email = notificationEmail("http://127.0.0.1:3000", draft.href, draft.payload); assert.ok(email.text.includes("Top up")); assert.ok(email.html.includes("&lt;update&gt;")); assert.ok(!email.html.includes("ss://")); assert.throws(() => notificationEmail("https://metro.example", "https://attacker.example", draft.payload)); assert.throws(() => notificationEmail("https://metro.example", "/plans", { ...draft.payload, message: "ss://private" })); });
test("email ambiguity cannot trigger automatic duplicate delivery", () => { assert.equal(deliveryFailure({ responseCode: 451 }), "RETRY"); assert.equal(deliveryFailure({ responseCode: 550 }), "FAILED"); assert.equal(deliveryFailure({ code: "EAUTH" }), "FAILED"); assert.equal(deliveryFailure({ command: "CONN", code: "ETIMEDOUT" }), "RETRY"); assert.equal(deliveryFailure({ command: "DATA", code: "ECONNRESET" }), "UNCERTAIN"); });
test('a backend mutation cannot bypass the committed receipt version through Connect or Show Key',async()=>{const saved=snapshot();const reference={userId,externalId:id,version:saved.version,snapshot:saved};const result=await liveServiceStatus(reference,async()=>({...saved,version:saved.version+1}),now);assert.equal(result.entitlement,null);assert.equal(result.status.canConnect,false);assert.equal(result.lastObservedAt,saved.observedAt)});
test('same-version key/quota/expiry/history mutations fail closed; fresh cumulative usage is accepted',async()=>{const saved=snapshot(),reference={userId,externalId:id,version:saved.version,snapshot:saved};for(const change of [{keyId:'other-key'},{totalBytes:'3221225472',remainingBytes:'2147483648'},{expiresAt:new Date(now+2*86400000).toISOString()},{usageHistoryVersion:0},{usedBytes:'0',remainingBytes:saved.totalBytes}]){const result=await liveServiceStatus(reference,async()=>({...saved,...change}),now);assert.equal(result.status.canConnect,false)}const live={...saved,usedBytes:(BigInt(saved.usedBytes)+1n).toString(),remainingBytes:(BigInt(saved.remainingBytes)-1n).toString()};assert.equal((await liveServiceStatus(reference,async()=>live,now)).status.canConnect,true)});
