import { test } from 'node:test';import assert from 'node:assert/strict';import {readFileSync}from'node:fs';import{createHash}from'node:crypto';import{renderToStaticMarkup}from'react-dom/server';import{createElement}from'react';
import{websiteKbzPay,kbzPayQr,matchesWebsiteKbzPay}from'../src/config/payments.ts';import{PaymentInstructions}from'../src/components/commerce/payment-instructions.tsx';import{customerOrderStatus}from'../src/features/pricing/order-status.ts';import{rejectionReasonSchema,rejectionReasons}from'../src/features/pricing/payment-review.ts';
test('the original user QR is unchanged and paired only with the confirmed website recipient',()=>{assert.equal(createHash('sha256').update(readFileSync('public'+kbzPayQr.src)).digest('hex'),'b1fa4372a35410ffdef789690e2a89c5ade25f3e00363f3cbbfabe1d1914ac4d');assert.equal(websiteKbzPay.accountName,'Shin Htet Maung');assert.equal(websiteKbzPay.accountNumber,'09442416930');assert.ok(matchesWebsiteKbzPay(websiteKbzPay));assert.equal(matchesWebsiteKbzPay({...websiteKbzPay,accountNumber:'OTHER'}),false);});
test('payment rendering includes exact whole-MMK amount, original download, recipient, copy and order instructions',()=>{const html=renderToStaticMarkup(createElement(PaymentInstructions,{method:websiteKbzPay,totalMmk:'123456789',orderId:'isolated-order'}));for(const value of ['123,456,789 MMK','09442416930','Shin Htet Maung','Copy phone number','/payments/kbzpay-original.png','download="metro-kbzpay-qr.png"','isolated-order','Pay this order only once'])assert.ok(html.includes(value),value);assert.ok(!html.includes('/_next/image'));const other=renderToStaticMarkup(createElement(PaymentInstructions,{method:{...websiteKbzPay,accountNumber:'OTHER'},totalMmk:'500'}));assert.ok(!other.includes(kbzPayQr.src));});
test('order status separates proof review, approval, processing, completed and recovery; never claims pending proof succeeded',()=>{for(const payment of ['UNVERIFIED','UNDER_REVIEW','REJECTED'])assert.ok(!customerOrderStatus({payment,state:'AWAITING_PAYMENT',provisioning:'NOT_REQUESTED'}).title.includes('completed'));assert.match(customerOrderStatus({payment:'CONFIRMED',state:'FULFILMENT_PENDING',provisioning:'PROCESSING'}).title,/activating/);assert.match(customerOrderStatus({payment:'CONFIRMED',state:'COMPLETE',provisioning:'SUCCEEDED'}).title,/completed/);assert.match(customerOrderStatus({payment:'CONFIRMED',state:'REVIEW_REQUIRED',provisioning:'REVIEW_REQUIRED'}).message,/Do not pay again/);for(const key of Object.keys(rejectionReasons))assert.ok(rejectionReasonSchema.safeParse(key).success);assert.equal(rejectionReasonSchema.safeParse('private secret').success,false);});

test('compact payment panel keeps the original QR and one proof-required primary submission',async()=>{const{CheckoutSubmit}=await import('../src/components/commerce/checkout-submit.tsx');const html=renderToStaticMarkup(createElement(PaymentInstructions,{method:websiteKbzPay,totalMmk:'5000',compact:true}));assert.ok(html.includes('Copy Number'));assert.ok(html.includes('Download QR'));assert.ok(html.includes('/payments/kbzpay-original.png'));assert.ok(!html.includes('Place your order'));const proof=renderToStaticMarkup(createElement(CheckoutSubmit,{orderId:'00000000-0000-4000-8000-000000000000'}));assert.match(proof,/type="file"[^>]*required/);assert.match(proof,/disabled=""[^>]*>Submit Payment for Review/);assert.ok(!proof.includes('Place order'));});
