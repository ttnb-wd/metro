import {test} from 'node:test';import assert from 'node:assert/strict';import {readFileSync,mkdtempSync,writeFileSync,rmSync} from 'node:fs';import {tmpdir} from 'node:os';import {join,resolve} from 'node:path';import {spawnSync} from 'node:child_process';
const source=readFileSync('../vpn/deploy/website-receipt-release.py','utf8').match(/rollback='''([\s\S]*?)'''/)?.[1];assert(source);
for(const mode of ['candidate','committed','foreign'])test(`release recovery ${mode}: never restarts Telegram or workers`,()=>{const root=mkdtempSync(join(tmpdir(),'metro-rollback-fixture-'));try{if(mode==='committed')writeFileSync(join(root,'committed'),'fixture');const harness=`import subprocess,json,sys\nfrom types import SimpleNamespace\ncalls=[]\ndef fake(a,**kw):\n calls.append(a)\n if a[:2]==['docker','inspect']:\n  if a[2]=='metro-website-api': return SimpleNamespace(returncode=0,stdout=json.dumps([{'Config':{'Labels':{'metro.receipt.release':${JSON.stringify(mode==='foreign'?'wrong':root.split(/[\\/]/).at(-1))}}}}]))\n  return SimpleNamespace(returncode=0,stdout='[]')\n return SimpleNamespace(returncode=0,stdout='')\nsubprocess.run=fake\nsys.argv=['rollback',${JSON.stringify(root)},'old-fixture']\ntry:exec(${JSON.stringify(source)})\nexcept SystemExit:pass\nprint(json.dumps(calls))`;
const r=spawnSync('python',['-c',harness],{encoding:'utf8',windowsHide:true,timeout:10000});assert.equal(r.status,0,r.stderr);const calls: string[][]=JSON.parse(r.stdout);assert.equal(calls.some(c=>c.some(v=>/metro-vpn-bot|commerce-worker|notification-worker/.test(v))),false);if(mode==='candidate'){assert(calls.some(c=>c.join(' ')==='docker rename old-fixture metro-website-api'));assert(calls.some(c=>c.join(' ')==='docker start metro-website-api'));}else{assert.equal(calls.some(c=>['stop','rm','rename','start'].includes(c[1])),false)}}finally{const checked=resolve(root);assert(checked.startsWith(resolve(tmpdir())+'\\')||checked.startsWith(resolve(tmpdir())+'/'));rmSync(checked,{recursive:true,force:true})}});
