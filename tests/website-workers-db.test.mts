import {test,after} from 'node:test';import assert from 'node:assert/strict';import {randomUUID} from 'node:crypto';import {PrismaClient} from '../src/server/db/generated/client.ts';import {PrismaPg} from '@prisma/adapter-pg';import {buildFulfilmentWorker} from '../src/server/commerce/worker.ts';import {fixtureReceipt} from './fulfilment-fixture.mts';import {fulfilmentEnabled} from '../src/server/commerce/config.ts';import type {Entitlement} from '../src/server/vpn/contracts.ts';
const raw=process.env.METRO_DISPOSABLE_BOOTSTRAP_URL!,workerUrl=process.env.METRO_DISPOSABLE_WORKER_URL!;for(const r of [raw,workerUrl]){const u=new URL(r);assert.equal(u.hostname,'127.0.0.1');assert.match(u.pathname,/^\/metro_disposable_[a-f0-9]{16}$/)}
const admin=new PrismaClient({adapter:new PrismaPg({connectionString:raw,max:4}),log:[]}),db=new PrismaClient({adapter:new PrismaPg({connectionString:workerUrl,max:2}),log:[]});
let owner=(await admin.ownerBinding.findUnique({where:{slot:1}}))?.userId;if(!owner){owner=randomUUID();await admin.user.create({data:{id:owner,name:'Fixture owner',email:owner+'@example.invalid',emailVerified:true}});await admin.ownerBinding.create({data:{slot:1,userId:owner}})}
async function seed(authorized=true,verified=true){const userId=randomUUID();await admin.user.create({data:{id:userId,name:'Isolated worker fixture',email:userId+'@example.invalid',emailVerified:verified}});const quote={id:randomUUID(),owner:{issuer:'metro-website',subject:userId},packageId:randomUUID(),pricingVersion:9,totalMmk:'1000',months:1,durationDays:30,quotaBytes:'1073741824'};const order=await admin.websiteOrder.create({data:{userId,quoteId:quote.id,quoteSnapshot:quote,totalMmk:'1000',state:'FULFILMENT_PENDING',payment:'CONFIRMED',provisioning:'QUEUED'}});const op=await admin.websiteOperation.create({data:{userId,kind:'PROVISION',resourceKey:order.id,orderId:order.id,frozenSnapshot:quote}});const event=await admin.websiteOutboxEvent.create({data:{userId,operationId:op.id,topic:'VPN_FULFILMENT_REQUESTED',businessKey:'fulfil:'+order.id,resourceId:order.id}});
if(authorized){const proof=await admin.paymentEvidence.create({data:{userId,orderId:order.id,storageRef:randomUUID(),sha256:'a'.repeat(64),mediaType:'image/png',bytes:100}});await admin.paymentDecision.create({data:{userId,orderId:order.id,evidenceId:proof.id,decision:'APPROVED',verificationRef:randomUUID(),amountMmk:'1000',ownerId:owner!,reasonCode:'PAYMENT_MATCHED'}});await admin.websiteAuditEvent.create({data:{actorId:owner!,targetUserId:userId,action:'PAYMENT_DECISION',outcome:'SUCCESS',resourceId:order.id,reasonCode:'PAYMENT_MATCHED',requestId:randomUUID(),idempotencyKey:randomUUID()}})}
const entitlement:Entitlement={id:randomUUID(),owner:{issuer:'metro-website',subject:userId},packageId:quote.packageId,version:0,keyId:'mw-'+randomUUID().replaceAll('-','')+'a'.repeat(16),keyStatus:'ENFORCED',status:'ACTIVE',totalBytes:quote.quotaBytes,usedBytes:'0',remainingBytes:quote.quotaBytes,expiresAt:new Date(Date.now()+30*86400000).toISOString(),usageHistoryVersion:0,observedAt:new Date().toISOString()};return{userId,quote,order,op,event,entitlement}}
async function pending(id:string){await admin.websiteOutboxEvent.update({where:{id},data:{availableAt:new Date(Date.now()-1000)}})}
for(const [name,authorized,verified]of [['forged confirmed status',false,true],['unverified customer',true,false]]as const)test(name+' cannot dispatch even with a durable queue item',async()=>{const f=await seed(authorized,verified);let calls=0;const w=buildFulfilmentWorker(db,async()=>{calls++;throw Error('Must not dispatch')},true);assert.equal((await w.runOne()).status,'REVIEW_REQUIRED');assert.equal(calls,0);assert.equal((await admin.websiteOperation.findUniqueOrThrow({where:{id:f.op.id}})).state,'REVIEW_REQUIRED');assert.equal((await admin.websiteOrder.findUniqueOrThrow({where:{id:f.order.id}})).payment,'CONFIRMED');assert.equal(await admin.websiteNotification.count({where:{dedupeKey:'review:'+f.op.id}}),1)});
test('actual dynamic activation gate prevents all claims and transport, not just startup',async()=>{const f=await seed();let active=false,calls=0;const w=buildFulfilmentWorker(db,async(_a,input)=>{calls++;return fixtureReceipt(input,f.entitlement)},()=>active,false);assert.equal((await w.runOne()).status,'DISABLED');assert.equal((await admin.websiteOutboxEvent.findUniqueOrThrow({where:{id:f.event.id}})).attempts,0);assert.equal(calls,0);active=true;assert.equal((await w.runOne()).status,'DELIVERED');assert.equal(calls,1);assert.equal((await w.runOne()).status,'IDLE');assert.equal((await admin.websiteOrder.findUniqueOrThrow({where:{id:f.order.id}})).state,'COMPLETE');active=false;assert.equal((await w.runOne()).status,'DISABLED')});
test('invalid authoritative receipt is quarantined immediately with OWNER and customer notices',async()=>{const f=await seed();const w=buildFulfilmentWorker(db,async(_a,input)=>({...fixtureReceipt(input,f.entitlement),verifiedFiniteLimitBytes:'0'}),true);assert.equal((await w.runOne()).status,'REVIEW_REQUIRED');assert.equal((await w.runOne()).status,'IDLE');assert.equal(await admin.websiteServiceReference.count({where:{userId:f.userId}}),0);assert.equal(await admin.websiteNotification.count({where:{dedupeKey:{in:['review:'+f.op.id,'customer-review:'+f.op.id]}}}),2)});
test('lost transport response retries the same operation and persists activation before a single notice',async()=>{const f=await seed();const receipt=fixtureReceipt({operationId:f.op.id,orderId:f.order.id,quote:f.quote},f.entitlement);const ids:string[]=[];let first=true;const w=buildFulfilmentWorker(db,async(_a,input)=>{ids.push((input as {operationId:string}).operationId);if(first){first=false;throw Error('Ambiguous timeout')}return receipt},true);assert.equal((await w.runOne()).status,'RETRY_PENDING');assert.equal(await admin.websiteServiceReference.count({where:{userId:f.userId}}),0);await pending(f.event.id);assert.equal((await w.runOne()).status,'DELIVERED');assert.deepEqual(ids,[f.op.id,f.op.id]);assert.equal(await admin.websiteNotification.count({where:{dedupeKey:'operation:'+f.op.id}}),1);assert.equal(await admin.websiteServiceReference.count({where:{userId:f.userId}}),1)});
test('expired lease restart and concurrent claims cannot commit duplicate fulfilment',async()=>{const f=await seed();await admin.websiteOutboxEvent.update({where:{id:f.event.id},data:{state:'LEASED',leaseId:randomUUID(),leaseUntil:new Date(Date.now()-1000)}});await admin.websiteOperation.update({where:{id:f.op.id},data:{state:'PROCESSING'}});let calls=0;const transport=async(_a:string,input:object)=>{calls++;await new Promise(r=>setTimeout(r,50));return fixtureReceipt(input,f.entitlement)};const a=buildFulfilmentWorker(db,transport,true),b=buildFulfilmentWorker(db,transport,true);const results=await Promise.all([a.runOne(),b.runOne()]);assert.equal(results.filter(r=>r.status==='DELIVERED').length,1);assert.equal(calls,1);assert.equal(await admin.websiteNotification.count({where:{dedupeKey:'operation:'+f.op.id}}),1)});
test('stale/unavailable observations preserve history and create one durable OWNER retry notice',async()=>{const f=await seed();const w=buildFulfilmentWorker(db,async(_a,input)=>fixtureReceipt(input,f.entitlement),true);assert.equal((await w.runOne()).status,'DELIVERED');const saved=await admin.websiteServiceReference.findFirstOrThrow({where:{userId:f.userId}});const refresh=buildFulfilmentWorker(db,async()=>({...f.entitlement,observedAt:new Date(Date.now()-600000).toISOString()}),false,true);await refresh.refreshServices(100);await refresh.refreshServices(100);assert.deepEqual((await admin.websiteServiceReference.findUniqueOrThrow({where:{id:saved.id}})).snapshot,saved.snapshot);assert.equal(await admin.websiteNotification.count({where:{userId:owner,dedupeKey:`observation:${saved.id}:${saved.capturedAt.toISOString()}`}}),1)});
test('observation cannot bypass a missing mutation receipt or lower recorded usage',async()=>{const f=await seed();const w=buildFulfilmentWorker(db,async(_a,input)=>fixtureReceipt(input,f.entitlement),true);assert.equal((await w.runOne()).status,'DELIVERED');const saved=await admin.websiteServiceReference.findFirstOrThrow({where:{userId:f.userId}});const observer=buildFulfilmentWorker(db,async()=>({...f.entitlement,version:1,totalBytes:'2147483648',remainingBytes:'2147483648',observedAt:new Date().toISOString()}),false,true);await observer.refreshServices(100);assert.deepEqual((await admin.websiteServiceReference.findUniqueOrThrow({where:{id:saved.id}})).snapshot,saved.snapshot)});
test('worker cannot read evidence locations, auth secrets, or mutate payment decisions and OWNER',async()=>{await assert.rejects(db.$queryRaw`SELECT "storageRef" FROM metro_payment_evidence`);await assert.rejects(db.$queryRaw`SELECT token FROM metro_session`);await assert.rejects(db.$executeRaw`UPDATE metro_owner_binding SET "userId"="userId"`);await assert.rejects(db.$executeRaw`UPDATE metro_payment_decision SET decision=decision`);assert.equal(fulfilmentEnabled({METRO_FULFILMENT_ENABLED:'true',METRO_VPN_EXECUTION_APPROVED:'true',METRO_VPN_FULFILMENT_RECEIPTS_VERIFIED:'false'}),false)});
after(async()=>{await db.$disconnect();await admin.$disconnect()});
