import {test,after} from 'node:test';import assert from 'node:assert/strict';import {randomUUID} from 'node:crypto';import {readFileSync} from 'node:fs';import {createRequire} from 'node:module';import {Client,Pool} from 'pg';
import type {Entitlement} from '../src/server/vpn/contracts.ts';
import {validateFulfilmentResult} from '../src/server/commerce/fulfilment-result.ts';
const require=createRequire(import.meta.url),{createWebsiteEngine}=require('../../vpn/src/website-service/engine.js'),{createWebsiteStore}=require('../../vpn/src/website-service/store.js'),{validateInput}=require('../../vpn/src/website-service/router.js');
const raw=process.env.METRO_RECEIPT_FIXTURE_URL!,u=new URL(raw);assert.equal(u.hostname,'127.0.0.1');assert.equal(u.username,'receipt_fixture');
const admin=new Client({connectionString:raw});await admin.connect();assert.equal((await admin.query('SELECT system_identifier::text AS id FROM pg_control_system()')).rows[0].id,process.env.METRO_RECEIPT_FIXTURE_ID);
await admin.query(readFileSync('../vpn/migrations/20261021000000_website_service.sql','utf8'));
const pool=new Pool({connectionString:raw,max:4});let clock=Date.now(),failFinish=false,createCount=0;
const keys=new Map<string,{id:string;accessUrl:string;dataLimit:{bytes:number}}>(),usage=new Map<string,number>(),windows=new Map<string,number>();
const outline={async getAccessKeyById(id:string){return keys.get(id)??null},async createWebsiteAccessKey(id:string){if(!keys.has(id)){createCount++;keys.set(id,{id,accessUrl:'ss://fake-isolated-'+id,dataLimit:{bytes:0}})}return keys.get(id)},async setAccessKeyDataLimit(id:string,bytes:number){keys.get(id)!.dataLimit.bytes=bytes},async deleteAccessKey(id:string){keys.delete(id)},isAccessKeyNotFoundError(){return false}};
function engine(fail=false){const store=createWebsiteStore(pool);return createWebsiteEngine({store:fail?{...store,locked:(id:string,fn: (r:unknown)=>unknown)=>store.locked(id,(r: {finish: (...a:unknown[])=>unknown})=>fn({...r,finish:async(...a:unknown[])=>{if(failFinish){failFinish=false;throw Error('LOST_COMPLETION')}return r.finish(...a)}}))}:store,outline,enabled:true,now:()=>clock,readUsage:async(id:string)=>({counterBytes:usage.get(id)??0,windowBytes:windows.get(id)??usage.get(id)??0,epoch:'isolated-process-1'})})}
const owner={issuer:'metro-website',subject:randomUUID()},packageId=randomUUID(),GB=1024**3;
function request(){return {action:'fulfil',owner,operationId:randomUUID(),orderId:randomUUID(),resultProtocol:'metro-fulfilment-receipt.v1',quote:{id:randomUUID(),pricingVersion:7,owner,packageId,policy:'metro-website-pricing.v1',currency:'MMK',baseDataGb:10,monthlyPriceMmk:'7500',regularMmk:'15000',savedMmk:'750',totalMmk:'14250',discountPercent:5,months:2,durationDays:60,quotaBytes:String(20*GB)}}}
function operation(i:ReturnType<typeof request>){return {id:i.operationId,userId:owner.subject,kind:'PROVISION',orderId:i.orderId,expectedVersion:null,createdAt:new Date(clock-1),frozenSnapshot:i.quote}}
let first:Entitlement,renewed:Entitlement,replaced:Entitlement;const initial=request(),initialOp=operation(initial);
test('real durable PostgreSQL operation + first-purchase receipt accepted by strict website validator',async()=>{const [a,b]=await Promise.all([engine().execute(initial),engine().execute(initial)]);assert.deepEqual(a,b);first=a.entitlement;assert.equal(createCount,1);assert.deepEqual(validateFulfilmentResult(a,initialOp,clock),first);assert.equal(a.purchase.durationDays,60);assert.equal(a.verifiedFiniteLimitBytes,String(20*GB));assert.equal(validateInput({version:'metro-commerce.v1',requestId:randomUUID(),...initial}),true)});
test('restart-safe replay after freshness window refreshes observation without reapplying purchase',async()=>{clock+=600001;usage.set(first.keyId,GB);windows.set(first.keyId,0);const replay=await engine().execute(initial);assert.equal(replay.completedAt,first.observedAt);assert.equal(replay.entitlement.usedBytes,String(GB));assert.equal(replay.verifiedFiniteLimitBytes,String(19*GB));assert.equal(createCount,1);assert.equal(validateFulfilmentResult(replay,initialOp,clock).totalBytes,first.totalBytes)});
test('same-key renewal carries unused data and exact 60-day expiry, rolling limit verified',async()=>{const r=request(),op=operation(r),receipt=await engine().execute(r);renewed=receipt.entitlement;assert.equal(renewed.keyId,first.keyId);assert.equal(renewed.totalBytes,String(40*GB));assert.equal(renewed.usedBytes,String(GB));assert.equal(Date.parse(renewed.expiresAt)-Date.parse(first.expiresAt),60*86400000);assert.equal(validateFulfilmentResult(receipt,op,clock,first).keyId,first.keyId);await assert.rejects(engine().execute(initial),/STALE_OPERATION/)});
test('replacement proves old-key absence, preserves exact expiry/quota and consumed offset',async()=>{const input={action:'replace',owner,operationId:randomUUID(),issueId:randomUUID(),entitlementId:renewed.id,expectedVersion:renewed.version,failureVerified:true,resultProtocol:'metro-fulfilment-receipt.v1'};const receipt=await engine().execute(input);replaced=receipt.entitlement;assert.equal(keys.has(renewed.keyId),false);assert.notEqual(replaced.keyId,renewed.keyId);assert.equal(receipt.usageOffsetBytes,String(GB));assert.equal(receipt.verifiedFiniteLimitBytes,String(39*GB));assert.equal(replaced.expiresAt,renewed.expiresAt);assert.deepEqual(validateFulfilmentResult(receipt,{id:input.operationId,userId:owner.subject,kind:'REPLACEMENT',orderId:null,expectedVersion:renewed.version,createdAt:new Date(clock-1),frozenSnapshot:renewed},clock,renewed),replaced);assert.deepEqual(await engine().execute(input),receipt)});
test('lost finish, engine restart and concurrent retries preserve exact frozen purchase',async()=>{const i=request(),op=operation(i);failFinish=true;await assert.rejects(engine(true).execute(i),/LOST_COMPLETION/);const [a,b]=await Promise.all([engine().execute(i),engine().execute(i)]);assert.deepEqual(a,b);assert.equal(validateFulfilmentResult(a,op,clock,replaced).totalBytes,String(60*GB));assert.equal(createCount,2)});
test('strict validation rejects mismatched operation/version, quota, expiry, raw usage and unlimited limits',async()=>{const i=request(),op=operation(i),r=await engine().execute(i);for(const patch of [ {operationId:randomUUID()},{quoteVersion:8},{completedAt:new Date(clock+60000).toISOString()},{purchase:{...r.purchase,quotaBytes:'1'}},{entitlement:{...r.entitlement,expiresAt:new Date(clock+1000).toISOString()}},{enforcement:{...r.enforcement,counterBytes:'0'}},{verifiedFiniteLimitBytes:'0'},{verifiedFiniteLimitBytes:String(Number.MAX_SAFE_INTEGER)}]){const bad={...r,...patch};if(patch.enforcement&&r.enforcement.counterBytes==='0')bad.enforcement.counterBytes='1';assert.throws(()=>validateFulfilmentResult(bad,op,clock))}});
test('legacy callers retain bare native entitlement responses, no Telegram module loaded',async()=>{const input=request();input.owner={issuer:'metro-website',subject:randomUUID()};input.quote.owner=input.owner;delete (input as {resultProtocol?:string}).resultProtocol;const result=await engine().execute(input);assert.equal(result.owner.issuer,'metro-website');assert.equal(result.protocol,undefined);assert.equal(result.keyStatus,'ENFORCED');assert.equal(Object.keys(require.cache).some(p=>/[/\\]src[/\\](bot|telegram-delivery|support)\.js$/.test(p)),false)});
test('usage regression fails closed; durable receipt cannot be forged after counter rollback',async()=>{const i=request();const r=await engine().execute(i);usage.set(r.entitlement.keyId,GB);await engine().execute({action:'entitlement',owner});usage.set(r.entitlement.keyId,0);await assert.rejects(engine().execute(i),/USAGE_RECONCILIATION_REQUIRED/);assert.equal(keys.get(r.entitlement.keyId)!.dataLimit.bytes,0)});
after(async()=>{await pool.end();await admin.end()});
