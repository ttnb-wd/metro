import{test}from'node:test';import assert from'node:assert/strict';import{randomUUID}from'node:crypto';import{safeReturnPath,isSafeAuthCallback}from'../src/features/auth/redirects.ts';import{resolveAccountDestination}from'../src/server/auth/account-routing-policy.ts';
const selection=`/checkout?package=${randomUUID()}&months=3&version=1&method=mobile_wallet`,origin='https://metro.example.invalid';
test('checkout selection survives the login return path without freezing its price',async()=>{assert.equal(safeReturnPath(selection),selection);assert.ok(isSafeAuthCallback(selection,origin));assert.ok(isSafeAuthCallback(origin+selection,origin));const owner=randomUUID(),customer=randomUUID();assert.equal(await resolveAccountDestination({id:customer,emailVerified:true},selection,async()=>owner),selection);assert.equal(await resolveAccountDestination({id:owner,emailVerified:true},selection,async()=>owner),'/admin');});
test('checkout return rejects open redirects, extra fields, duplicate parameters and invalid selections',()=>{for(const path of ['https://evil.invalid'+selection,'//evil.invalid'+selection,selection+'&next=https://evil.invalid',selection+'&months=1',selection.replace('months=3','months=13'),selection.replace('version=1','version=0'),selection.replace('method=mobile_wallet','method=%2f%2fevil.invalid'),selection+'#evil',selection+'\r\n', '/dashboard?next='+selection]){assert.equal(safeReturnPath(path),'/dashboard',path);assert.equal(isSafeAuthCallback(path,origin),false,path)}assert.equal(isSafeAuthCallback('https://evil.invalid'+selection,origin),false);});

test('an owned draft return path is narrowly allowed without accepting other destinations',()=>{const draft=`/checkout?draft=${randomUUID()}`;assert.equal(safeReturnPath(draft),draft);assert.ok(isSafeAuthCallback(draft,origin));for(const bad of [draft+'&next=https://evil.invalid',draft+'&draft='+randomUUID(),'/checkout?draft=not-a-uuid','https://evil.invalid'+draft]){assert.equal(safeReturnPath(bad),'/dashboard');assert.equal(isSafeAuthCallback(bad,origin),false)}});
