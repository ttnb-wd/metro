# Harmless template only. Keep authentication disabled until explicitly approved.
# Real dedicated website credentials belong only in the ignored .env.local.
METRO_AUTH_ENABLED=false
METRO_WEBSITE_FOUNDATION_ENABLED=false
# Change only during the approved credential cutover. Legacy default preserves existing auth.
METRO_DATABASE_RUNTIME_ROLE=neondb_owner
# Restricted runtime after cutover: METRO_DATABASE_RUNTIME_ROLE=metro_runtime

# Dedicated Metro Website PostgreSQL database and role only.
# Never reuse production VPN/Aiven credentials. No DATABASE_URL fallback exists.
# Pooled runtime URL. Remote connections require sslmode=verify-full.
# Optional channel_binding=prefer or require is mapped to native pg binding;
# require rejects connections that do not negotiate SCRAM-SHA-256-PLUS.
METRO_DATABASE_URL=

# Optional separate unpooled URL for future approved migration work.
# Leave unset until configured; never use it as the runtime URL fallback.
# METRO_DIRECT_DATABASE_URL=

# Unique cryptographically random secret, at least 32 characters. Do not reuse.
BETTER_AUTH_SECRET=

# Exact website origin. HTTPS required except for loopback development.
BETTER_AUTH_URL=http://127.0.0.1:3000

# Optional, only after reviewing a proxy that overwrites/sanitizes the header.
# Allowed: x-real-ip or cf-connecting-ip. Leave unset for the shared limit bucket.
# METRO_AUTH_TRUSTED_IP_HEADER=

# Server-only Gmail SMTP. Use a Google App Password; never a normal password.
# SMTP host/port/TLS are pinned in code. No NEXT_PUBLIC_ variants.
SMTP_USER=metro.service.net@gmail.com
SMTP_APP_PASSWORD=
