# Harmless template only. Keep authentication disabled until explicitly approved.
# Real dedicated website credentials belong only in the ignored .env.local.
METRO_AUTH_ENABLED=false
METRO_WEBSITE_FOUNDATION_ENABLED=false
# Change only during the approved credential cutover. Legacy default preserves existing auth.
METRO_DATABASE_RUNTIME_ROLE=neondb_owner
# Restricted runtime after cutover: METRO_DATABASE_RUNTIME_ROLE=metro_runtime

# Dedicated Metro Website PostgreSQL database and role only.
# Never reuse production VPN/Aiven credentials. No DATABASE_URL fallback exists.
# Pooled runtime URL. Remote connections require sslmode=verify-full.
# Optional channel_binding=prefer or require is mapped to native pg binding;
# require rejects connections that do not negotiate SCRAM-SHA-256-PLUS.
METRO_DATABASE_URL=

# Optional separate unpooled URL for future approved migration work.
# Leave unset until configured; never use it as the runtime URL fallback.
# METRO_DIRECT_DATABASE_URL=

# Unique cryptographically random secret, at least 32 characters. Do not reuse.
BETTER_AUTH_SECRET=

# Exact website origin. HTTPS required except for loopback development.
BETTER_AUTH_URL=http://127.0.0.1:3000

# Authentication ingress: Vercel's system VERCEL=1 enables its overwritten
# x-real-ip header. Do not set VERCEL manually on another host. Missing trusted
# production ingress fails closed; development uses opaque account buckets.
# The old METRO_AUTH_TRUSTED_IP_HEADER override is no longer used.
# A separately reviewed private self-hosted Caddy ingress can use this token.
# Never provide it to the browser, and never expose the raw web port publicly.
# METRO_AUTH_PROXY_SECRET=

# Server-only Gmail SMTP. Use a Google App Password; never a normal password.
# SMTP host/port/TLS are pinned in code. No NEXT_PUBLIC_ variants.
SMTP_USER=metro.service.net@gmail.com
SMTP_APP_PASSWORD=

# Choose imagekit for serverless production. Local remains the existing-host default.
# No generic IMAGEKIT_* or GOSH configuration is read.
METRO_EVIDENCE_PROVIDER=
METRO_IMAGEKIT_PRIVATE_KEY=
METRO_IMAGEKIT_URL_ENDPOINT=
METRO_IMAGEKIT_FOLDER=
# Legacy local evidence only: keep the original volume/key for approved migration.
# Never configure these as the production Vercel payment storage.
# METRO_EVIDENCE_DIRECTORY=
# METRO_EVIDENCE_ENCRYPTION_KEY=
# Optional validated website-only payment methods JSON. Placeholder accounts are rejected.
# METRO_PAYMENT_METHODS_JSON=

# Closed until reviewed production backend, roles, recovery and execution approval.
METRO_FULFILMENT_ENABLED=false
METRO_VPN_EXECUTION_APPROVED=false
# Keep false until the VPN backend emits and rehearses the complete
# metro-fulfilment-receipt.v1 result contract. Existing bare snapshots fail closed.
METRO_VPN_FULFILMENT_RECEIPTS_VERIFIED=false
METRO_VPN_OBSERVATION_ENABLED=false
METRO_VPN_SERVICE_ORIGIN=
METRO_VPN_SERVICE_KEY_ID=
METRO_VPN_SERVICE_SECRET=
# Dedicated worker process only. Never provide its database credential to Next.js.
# METRO_COMMERCE_WORKER_DATABASE_URL=

# Enable only after the approved website notification migration/grants.
METRO_NOTIFICATIONS_ENABLED=false
# Email delivery requires a public HTTPS website origin; keep paused otherwise.
METRO_NOTIFICATION_EMAIL_ENABLED=false
# Separate notification process only. Never provide this credential to Next.js.
# METRO_NOTIFICATION_WORKER_DATABASE_URL=
# The notification worker reuses SMTP_USER/SMTP_APP_PASSWORD server-side.
